# Copy this file to `.env` and fill in values for local development.
# Vite only exposes variables prefixed with `VITE_` to the browser bundle.

# Config profile under src/config/<name>/ (falls back to "default")
VITE_CONFIG_ENV=main

# Free CARTO Basemaps API key — removes the "API KEY REQUIRED" watermark
# on carto-light / carto-dark tiles. Without it the map still works.
# Get a key at: https://carto.com/basemaps/apikey
# Used in: src/config/default/themes.js
VITE_CARTO_API_KEY=

# Google Apps Script deployment ID for the Support contact form.
# Endpoint becomes: https://script.google.com/macros/s/{ID}/exec
# Used in: src/views/Support.vue
VITE_CONTACTS_FORM_SCRIPT_ID=

# hCaptcha site key (public) for the Support form captcha.
# Used in: src/views/Support.vue
VITE_HCAPTCHA_SITE_KEY=

# Host directory for cached tiles; must be writable by uid 1000 (the node user)
CACHE_PATH=./cache

# Port on 127.0.0.1
PORT=3081

# Cache limits: size in bytes (10 GiB) and age in days
CACHE_MAX_BYTES=10737418240
CACHE_DAYS=6

# Prefetch of the current three-hour step at zooms 2-6
PREFETCH_ENABLED=true
PREFETCH_CONCURRENCY=8
